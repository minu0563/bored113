"use client";

import React, { useEffect, useRef, useState } from 'react';

const Ascii3D = () => {
  const preRef = useRef<HTMLPreElement>(null);
  const [frame, setFrame] = useState("");

  useEffect(() => {
    let A = 0;
    let B = 0;
    let animationId: number;

    const renderFrame = () => {
      const b: string[] = [];
      const z: number[] = [];
      // 화면 크기에 맞춘 버퍼 설정 (80x40 정도가 적당함)
      const width = 80;
      const height = 40;
      
      for (let k = 0; k < width * height; k++) {
        b[k] = " ";
        z[k] = 0;
      }

      // 3D 토러스(도넛) 계산 루프
      for (let j = 0; j < 6.28; j += 0.07) {
        for (let i = 0; i < 6.28; i += 0.02) {
          const c = Math.sin(i);
          const d = Math.cos(j);
          const e = Math.sin(A);
          const f = Math.sin(j);
          const g = Math.cos(A);
          const h = d + 2;
          const D = 1 / (c * h * e + f * g + 5);
          const l = Math.cos(i);
          const m = Math.cos(B);
          const n = Math.sin(B);
          const t = c * h * g - f * e;

          // 2D 평면 투영 좌표 계산
          const x = Math.floor(width / 2 + 30 * D * (l * h * m - t * n));
          const y = Math.floor(height / 2 + 15 * D * (l * h * n + t * m));
          const o = x + width * y;

          // 광원 계산 (명암에 따른 ASCII 문자 선택)
          const N = Math.floor(8 * ((f * e - c * d * g) * m - c * d * e - f * g - l * d * n));

          if (height > y && y >= 0 && width > x && x >= 0 && D > z[o]) {
            z[o] = D;
            // 명암 단계별 문자: . , - ~ : ; = ! * # $ @
            b[o] = ".,-~:;=!*#$@"[N > 0 ? N : 0];
          }
        }
      }

      // 버퍼를 문자열로 변환
      let output = "";
      for (let k = 0; k < width * height; k++) {
        output += k % width === width - 1 ? b[k] + "\n" : b[k];
      }
      
      setFrame(output);
      A += 0.04; // 회전 속도 조절
      B += 0.02;
      animationId = requestAnimationFrame(renderFrame);
    };

    renderFrame();
    return () => cancelAnimationFrame(animationId);
  }, []);

  return (
    <div className="min-h-screen bg-black flex flex-col items-center justify-center p-4 overflow-hidden">
      {/* 노이즈와 스캔라인 효과 추가 */}
      <div className="relative group">
        <div className="absolute -inset-1 bg-green-500/20 blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
        <pre 
          ref={preRef}
          className="relative bg-black border border-green-900/50 p-6 font-mono text-[10px] leading-[8px] md:text-xs md:leading-[10px] text-green-500 shadow-[0_0_20px_rgba(34,197,94,0.2)] select-none whitespace-pre"
        >
          {frame}
        </pre>
      </div>

      {/* 하단 시스템 오버레이 */}
      <div className="mt-8 w-full max-w-2xl border-t border-green-900/30 pt-4 flex justify-between font-mono text-[10px] text-green-800">
        <div className="flex gap-4">
          <span className="animate-pulse">● SIGNAL_STRENGTH: 98%</span>
          <span>CPU_CORE_CALC: ACTIVE</span>
        </div>
        <div className="uppercase tracking-widest">
          Terminal Mode: ASCII_RENDER_V1
        </div>
      </div>

      <style jsx global>{`
        body {
          background-color: black;
        }
        /* 스캔라인 효과 */
        pre::before {
          content: " ";
          display: block;
          position: absolute;
          top: 0; left: 0; bottom: 0; right: 0;
          background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
          z-index: 2;
          background-size: 100% 2px, 3px 100%;
          pointer-events: none;
        }
      `}</style>
    </div>
  );
};

export default Ascii3D;
