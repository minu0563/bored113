<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>TERMINAL_OVERRIDE_2026</title>
    <style>
        :root {
            --neon: #00ff41;
            --dark-green: #003300;
            --bg: #050505;
        }

        body {
            background-color: var(--bg);
            color: var(--neon);
            font-family: 'Courier New', monospace;
            margin: 0; overflow: hidden;
            display: flex; justify-content: center; align-items: center;
            height: 100vh;
        }

        #canvas { position: absolute; top: 0; left: 0; z-index: 1; opacity: 0.3; }

        /* 메인 프레임 */
        .main-container {
            position: relative; z-index: 10;
            width: 90vw; height: 80vh;
            display: grid;
            grid-template-columns: 250px 1fr 200px;
            gap: 20px;
        }

        .panel {
            background: rgba(0, 20, 0, 0.8);
            border: 1px solid var(--neon);
            box-shadow: inset 0 0 10px var(--dark-green);
            padding: 15px;
            position: relative;
            overflow: hidden;
        }

        /* 터미널 출력창 */
        .terminal-window {
            overflow-y: auto;
            border: 2px solid var(--neon);
            background: rgba(0, 10, 0, 0.9);
        }

        /* 헤더 스타일 */
        .panel-header {
            font-size: 0.8rem; font-weight: bold;
            border-bottom: 1px solid var(--neon);
            margin-bottom: 15px; padding-bottom: 5px;
            display: flex; justify-content: space-between;
        }

        .response { margin-bottom: 12px; line-height: 1.4; font-size: 0.95rem; }
        .cursor { display: inline-block; width: 8px; height: 15px; background: var(--neon); animation: blink 1s infinite; }

        /* 상태 게이지 애니메이션 */
        .stat-bar { height: 10px; background: #111; border: 1px solid var(--neon); margin: 10px 0; position: relative; }
        .stat-fill { height: 100%; background: var(--neon); width: 0%; transition: width 0.5s; }

        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

        /* 스캔라인 효과 (전체 화면) */
        .scanline {
            width: 100%; height: 100%; position: absolute; top: 0; left: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%);
            background-size: 100% 4px; z-index: 100; pointer-events: none;
        }
    </style>
</head>
<body>

<canvas id="canvas"></canvas>
<div class="scanline"></div>

<div class="main-container">
    <div class="panel">
        <div class="panel-header"><span>SYS_ANALYSIS</span><span>v1.2</span></div>
        <p style="font-size: 0.7rem;">CPU_LOAD</p>
        <div class="stat-bar"><div class="stat-fill" id="cpu-bar"></div></div>
        <p style="font-size: 0.7rem;">MEM_USAGE</p>
        <div class="stat-bar"><div class="stat-fill" id="mem-bar"></div></div>
        <div id="sys-logs" style="font-size: 0.6rem; margin-top: 20px; color: #008822;"></div>
    </div>

    <div class="panel terminal-window">
        <div class="panel-header"><span>MAIN_TERMINAL</span><span>127.0.0.1</span></div>
        <div id="output"></div>
        <div class="command">> READY_FOR_COMMAND...<span class="cursor"></span></div>
    </div>

    <div class="panel">
        <div class="panel-header"><span>NODES</span></div>
        <div id="nodes" style="font-size: 0.7rem;"></div>
    </div>
</div>

<script>
    // 1. 매트릭스 배경 (기존 코드 개선)
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth; canvas.height = window.innerHeight;
    const chars = "0123456789ABCDEF";
    const fontSize = 14;
    const columns = canvas.width / fontSize;
    const drops = Array(Math.floor(columns)).fill(1);

    function drawMatrix() {
        ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#004400";
        ctx.font = fontSize + "px monospace";
        for (let i = 0; i < drops.length; i++) {
            const text = chars[Math.floor(Math.random() * chars.length)];
            ctx.fillText(text, i * fontSize, drops[i] * fontSize);
            if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
            drops[i]++;
        }
    }

    // 2. 터미널 출력
    const output = document.getElementById('output');
    const messages = [
        "INITIALIZING DEEP_SCAN...",
        "ENCRYPTED TUNNEL ESTABLISHED.",
        "BYPASSING BIO-METRIC LOCK... SUCCESS.",
        "DECRYPTING DATABASE: [######----] 62%",
        "CAUTION: UNKNOWN TRACE DETECTED.",
        "ROOT ACCESS GRANTED. WELCOME ADMIN."
    ];

    let msgIndex = 0;
    function typeMessage() {
        if (msgIndex < messages.length) {
            const div = document.createElement('div');
            div.className = 'response';
            div.innerHTML = `<span style="color:#888">[${new Date().toLocaleTimeString()}]</span> > ${messages[msgIndex]}`;
            output.appendChild(div);
            msgIndex++;
            setTimeout(typeMessage, 1000);
            output.parentElement.scrollTop = output.parentElement.scrollHeight;
        }
    }

    // 3. 사이드 패널 데이터 업데이트 (실시간 느낌)
    function updateStats() {
        document.getElementById('cpu-bar').style.width = Math.random() * 100 + '%';
        document.getElementById('mem-bar').style.width = (40 + Math.random() * 20) + '%';
        
        const log = document.getElementById('sys-logs');
        const logLine = document.createElement('div');
        logLine.innerText = `ID_${Math.floor(Math.random()*999)}: OK`;
        log.prepend(logLine);
        if(log.children.length > 10) log.removeChild(log.lastChild);

        const nodes = document.getElementById('nodes');
        nodes.innerHTML = Array(5).fill(0).map(() => `NODE_${Math.floor(Math.random()*9000+1000)}: ONLINE<br>`).join('');
    }

    setInterval(drawMatrix, 50);
    setInterval(updateStats, 2000);
    setTimeout(typeMessage, 800);

    window.addEventListener('resize', () => {
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
    });
</script>

</body>
</html>
