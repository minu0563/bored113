"use client";

import { motion, useScroll, useTransform, useSpring, useInView } from "framer-motion";
import { useRef, useState, useEffect } from "react";

export default function SurrealPage() {
  const containerRef = useRef(null);
  const { scrollYProgress } = useScroll({
    target: containerRef,
    offset: ["start start", "end end"],
  });

  // 부드러운 스크롤 값을 위한 스프링
  const smoothProgress = useSpring(scrollYProgress, { stiffness: 100, damping: 30 });

  return (
    <main ref={containerRef} className="relative bg-[#080808] text-white selection:bg-white selection:text-black">
      {/* 고정된 동적 배경 (개쩌는 포인트: 마우스 위치에 반응하는 가변 광원) */}
      <DynamicBackground />

      {/* SECTION 1: 타이포그래피 가변 노출 */}
      <section className="relative h-[200vh] flex flex-col items-center justify-center">
        <div className="sticky top-0 h-screen w-full flex items-center justify-center overflow-hidden">
          <motion.div 
            style={{ 
              scale: useTransform(smoothProgress, [0, 0.5], [1, 15]),
              opacity: useTransform(smoothProgress, [0, 0.4], [1, 0])
            }}
            className="text-center z-10"
          >
            <h1 className="text-[12vw] font-black italic leading-none tracking-tighter mix-blend-difference">
              NOISE<br/>&PAIN
            </h1>
          </motion.div>
          
          {/* 스크롤 시 나타나는 서브 텍스트 */}
          <motion.div 
            style={{ opacity: useTransform(smoothProgress, [0.3, 0.6], [0, 1]) }}
            className="absolute inset-0 flex items-center justify-center"
          >
            <p className="text-4xl font-light tracking-[2em] uppercase opacity-20">The Void Calls</p>
          </motion.div>
        </div>
      </section>

      {/* SECTION 2: 3D 텍스트 월 (스크롤 시 기울어짐) */}
      <section className="relative py-40 overflow-hidden bg-white text-black">
        <div className="flex flex-col gap-10">
          {[1, 2, 3, 4, 5].map((i) => (
            <ScrollingText key={i} direction={i % 2 === 0 ? 1 : -1} baseVelocity={i * 2} progress={smoothProgress} />
          ))}
        </div>
      </section>

      {/* SECTION 3: 인터랙티브 하이라이트 카드 */}
      <section className="min-h-screen py-60 px-6 flex flex-col items-center gap-40">
        <RevealHeading text="PERFECTION" />
        <div className="grid grid-cols-1 md:grid-cols-2 gap-20 w-full max-w-6xl">
          <InteractiveCard title="CHAOS" desc="Systematic disruption of the standard web." color="bg-red-500" />
          <InteractiveCard title="ORDER" desc="Perfectly aligned pixels in a digital world." color="bg-blue-500" />
        </div>
        <RevealHeading text="IS_BORING" />
      </section>

      {/* FOOTER */}
      <footer className="h-screen flex items-center justify-center bg-black">
        <motion.button 
          whileHover={{ scale: 1.1, letterSpacing: "1em" }}
          className="text-4xl md:text-7xl font-black uppercase transition-all duration-500 border-b-4 border-white pb-4"
        >
          Wake Up
        </motion.button>
      </footer>
    </main>
  );
}

// 1. 마우스 반응형 배경 로직
function DynamicBackground() {
  const [mPos, setMPos] = useState({ x: 0, y: 0 });
  useEffect(() => {
    const move = (e: MouseEvent) => setMPos({ x: e.clientX, y: e.clientY });
    window.addEventListener("mousemove", move);
    return () => window.removeEventListener("mousemove", move);
  }, []);

  return (
    <div className="fixed inset-0 z-0 pointer-events-none overflow-hidden">
      <motion.div 
        animate={{ x: mPos.x - 300, y: mPos.y - 300 }}
        className="w-[600px] h-[600px] bg-indigo-600/30 rounded-full blur-[160px] absolute opacity-60"
      />
      <div className="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,transparent_0%,#080808_80%)]" />
    </div>
  );
}

// 2. 가로로 흐르는 무한 텍스트 (스크롤 속도 연동)
function ScrollingText({ direction, baseVelocity, progress }: any) {
  const x = useTransform(progress, [0, 1], [0, direction * 1000]);
  return (
    <motion.div style={{ x }} className="flex whitespace-nowrap text-[8vw] font-black uppercase leading-none italic">
      {Array(10).fill(0).map((_, i) => (
        <span key={i} className="mr-20 outline-text">Experimental Design —</span>
      ))}
      <style jsx>{`.outline-text { -webkit-text-stroke: 1px black; color: transparent; }`}</style>
    </motion.div>
  );
}

// 3. 글자가 쪼개지며 나타나는 헤딩
function RevealHeading({ text }: { text: string }) {
  return (
    <motion.h2 
      initial={{ y: 100, opacity: 0 }}
      whileInView={{ y: 0, opacity: 1 }}
      transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}
      className="text-[15vw] font-black tracking-tighter"
    >
      {text}
    </motion.h2>
  );
}

// 4. 마우스 오버 시 색상이 터지는 카드
function InteractiveCard({ title, desc, color }: any) {
  return (
    <motion.div 
      whileHover="hover"
      className="group relative aspect-[4/5] rounded-[2.5rem] bg-neutral-900 border border-white/10 overflow-hidden p-10 flex flex-col justify-end cursor-crosshair"
    >
      <motion.div 
        variants={{ hover: { scale: 1.5, opacity: 1 } }}
        initial={{ opacity: 0 }}
        className={`absolute top-0 right-0 w-64 h-64 ${color} blur-[100px] -mr-32 -mt-32 transition-all duration-700`}
      />
      <h3 className="text-6xl font-black mb-4 relative z-10">{title}</h3>
      <p className="text-neutral-500 text-xl max-w-xs relative z-10">{desc}</p>
    </motion.div>
  );
}
