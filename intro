<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>CYBERPUNK TERMINAL 2026</title>
    <style>
        body {
            background-color: #050505;
            color: #00ff41;
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        #canvas {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .terminal-window {
            position: relative;
            z-index: 2;
            width: 80%;
            max-width: 800px;
            height: 500px;
            background: rgba(0, 20, 0, 0.85);
            border: 2px solid #00ff41;
            box-shadow: 0 0 20px rgba(0, 255, 65, 0.5);
            padding: 20px;
            overflow-y: auto;
            border-radius: 5px;
        }

        .command { color: #ffffff; margin-bottom: 10px; }
        .response { color: #00ff41; margin-bottom: 20px; line-height: 1.5; }
        .cursor { display: inline-block; width: 10px; height: 18px; background: #00ff41; animation: blink 0.8s infinite; }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        /* 스캔라인 효과 */
        .terminal-window::before {
            content: " ";
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 3;
            background-size: 100% 4px, 3px 100%;
            pointer-events: none;
        }
    </style>
</head>
<body>

<canvas id="canvas"></canvas>

<div class="terminal-window" id="terminal">
    <div id="output"></div>
    <div class="command">> ACCESS_GRANTED: INITIALIZING_SYSTEM...<span class="cursor"></span></div>
</div>

<script>
    // 1. 매트릭스 배경 효과
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    const characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*()";
    const fontSize = 16;
    const columns = canvas.width / fontSize;
    const drops = Array(Math.floor(columns)).fill(1);

    function drawMatrix() {
        ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#003300"; // 배경 글자색
        ctx.font = fontSize + "px monospace";

        for (let i = 0; i < drops.length; i++) {
            const text = characters.charAt(Math.floor(Math.random() * characters.length));
            ctx.fillText(text, i * fontSize, drops[i] * fontSize);
            if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
            drops[i]++;
        }
    }

    // 2. 터미널 텍스트 효과
    const output = document.getElementById('output');
    const messages = [
        "Connecting to secure server... DONE",
        "Bypassing firewall... SUCCESS",
        "Loading core_modules... [■■■■■■■■■□] 90%",
        "System Check: CPU Optimal / Memory Stable",
        "Welcome, USER_2026. Ready to build something crazy?"
    ];

    let msgIndex = 0;

    function typeMessage() {
        if (msgIndex < messages.length) {
            const div = document.createElement('div');
            div.className = 'response';
            div.innerHTML = `> ${messages[msgIndex]}`;
            output.appendChild(div);
            msgIndex++;
            setTimeout(typeMessage, 800);
            output.parentElement.scrollTop = output.parentElement.scrollHeight;
        }
    }

    setInterval(drawMatrix, 50);
    setTimeout(typeMessage, 500);

    window.addEventListener('resize', () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    });
</script>

</body>
</html>
